# API Configuration
# Set your OpenAI API key here
API_KEY=your_api_key_here
LLM_API_KEY=your_api_key_here

# API Base URLs (use official OpenAI API)
BASE_URL=https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# VLM Configuration (for local Qwen model)
VLM_BASE_URL=http://localhost:8000/v1
VLM_API_KEY=EMPTY

# Server Configuration (for annotation pipeline file uploads)
SERVER_IP=localhost
UPLOAD_DIR=./uploads/

# Style data file (for evaluation scripts)
STYLE_JSON_FILE=./style_data.json
